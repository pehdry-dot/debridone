{
  "name": "debridone",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "DebridOne — personal entertainment hub, as a web app and a macOS app.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop:build": "npm run build && electron-builder --mac --arm64",
    "icon": "bash scripts/make-icon.sh"
  },
  "dependencies": {
    "dompurify": "^3.1.6",
    "framer-motion": "^11.11.0",
    "hls.js": "^1.7.4",
    "idb-keyval": "^6.2.1",
    "jszip": "^3.10.1",
    "lucide-react": "0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "electron": "^44.9.3",
    "electron-builder": "^26.16.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.debridone.app",
    "productName": "DebridOne",
    "copyright": "Personal build",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "darkModeSupport": true,
      "hardenedRuntime": false
    },
    "dmg": {
      "title": "DebridOne"
    }
  },
  "author": "DebridOne"
}
